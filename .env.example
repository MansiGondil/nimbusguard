# Copy to .env and adjust. All settings use the NG_ prefix (see backend/app/config.py).

# --- Security (CHANGE THESE) ---
NG_SECRET_KEY=replace-with-a-long-random-string
NG_ADMIN_PASSWORD=nimbusguard
# Optional dedicated Fernet key for encrypting device credentials:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# NG_ENCRYPTION_KEY=

# --- Demo mode ---
NG_SIMULATOR_ENABLED=true
NG_SIMULATOR_DEVICES=24
# Speed up demo time (rule durations and playbook waits shrink by this factor)
NG_TIME_SCALE=10
NG_PREDICTION_LOOKBACK_MINUTES=10
NG_PERSIST_INTERVAL_SECONDS=15
NG_ANALYSIS_INTERVAL_SECONDS=10
# Inject a random fault every N minutes (0 = off)
NG_SIMULATOR_CHAOS_MINUTES=0

# --- Real collectors ---
NG_SNMP_ENABLED=false
NG_CLOUD_ENABLED=false   # AWS CloudWatch, needs boto3 + AWS credentials
NG_SYSLOG_ENABLED=false
NG_NETFLOW_ENABLED=false

# --- Automation safety ---
NG_AUTO_REMEDIATION_ENABLED=true
NG_MAX_FIXES_PER_DEVICE_PER_HOUR=3
NG_IMPACT_APPROVAL_THRESHOLD=3
NG_MAINTENANCE_WINDOW=00:00-06:00

# --- Notifications (mobile push via https://ntfy.sh, or any webhook) ---
# NG_NTFY_TOPIC=my-org-nimbusguard-alerts
# NG_WEBHOOK_URL=https://hooks.slack.com/services/...

# --- Executive dashboard cost model ---
NG_DOWNTIME_COST_PER_HOUR=500
NG_AVG_INCIDENT_HOURS_AVOIDED=1.5
